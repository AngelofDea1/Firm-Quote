# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored. Never commit a real key.
# ---------------------------------------------------------------------------

# -- Chain -------------------------------------------------------------------
# Gas on X Layer is paid in OKB, not ETH. Fund from the faucet before testnet work.
DEPLOYER_PRIVATE_KEY=
XLAYER_TESTNET_RPC=https://testrpc.xlayer.tech/terigon
XLAYER_RPC=https://rpc.xlayer.tech
# Public RPCs are limited to ~100 req/s per IP. If testing gets heavy, put a
# dedicated QuickNode/Chainstack endpoint here instead.

# Which deployment the backend reads: localhost | xlayerTestnet | xlayer
NETWORK=localhost
RPC_URL=

# Signs oracle-only calls (resolveOutcome, updatePrice). Defaults to the deployer.
ORACLE_PRIVATE_KEY=
# The tranche holder the demo exits on behalf of. On a single-key network, leave blank.
# For `npm run seed:local` this is hardhat account #3.
HOLDER_PRIVATE_KEY=

# -- Risk engine -------------------------------------------------------------
# Optional. With no key the engine runs its deterministic scoring path, which is a
# real model and produces defensible numbers. The demo never dies on a network failure.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# -- OKX DEX -----------------------------------------------------------------
# Three values are required: key, secret, passphrase. There is NO project id on v6.
# https://web3.okx.com/build/docs/waas/dex-introduction
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_API_PASSPHRASE=
# Not required on the v6 API. Leave blank unless you know you need it.
OKX_PROJECT_ID=
OKX_BASE_URL=https://web3.okx.com

# -- Deal parameters (all optional, sensible defaults in the scripts) ---------
ASSET_LABEL=INV-2026-Q3-BATCH-001
DEAL_NAME=Invoice Q3
MATURITY_DAYS=90
MIN_BOND=50000
TOLERANCE_BPS=200
FULL_SLASH_ERROR_BPS=1000
SENIOR_DEPOSIT=800000
JUNIOR_DEPOSIT=200000
POOL_LIQUIDITY=500000
# 0 for demo networks so a fresh wallet can participate. Leave at 5000 on mainnet.
MIN_WALLET_AGE_BLOCKS=0
# Use a real deployed stablecoin here on mainnet; blank deploys a mock for the demo.
SETTLEMENT_TOKEN=
ORIGINATOR_ADDRESS=
COUNTERPARTY_ADDRESS=

# -- Verification ------------------------------------------------------------
OKLINK_API_KEY=
